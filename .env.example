# ── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/info_marketplace"

# ── App / Auth ───────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── PayPal (Business account — powers card, debit, and PayPal wallet) ──
# Get these from developer.paypal.com → Apps & Credentials
PAYPAL_ENV="sandbox"              # "sandbox" while testing, "live" for real payments
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""   # same as PAYPAL_CLIENT_ID, exposed to the browser for the SDK
PAYPAL_WEBHOOK_ID=""              # from PayPal Dashboard → Webhooks, used to verify webhook signatures

# ── Email (any SMTP provider: Resend, Postmark, SES, Gmail SMTP, etc.) ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="INFO <no-reply@yourdomain.com>"

# ── Seed data (used only by `npm run db:seed`) ──────────────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-immediately"

# Crypto wallet addresses are NOT set here — manage them from
# Admin Dashboard → Payment Settings after logging in, so they can be
# rotated without a redeploy.
